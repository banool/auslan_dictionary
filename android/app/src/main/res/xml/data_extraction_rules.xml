<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-to-device transfer, Android 12 and later. Same rules
     as backup_rules.xml (which explains them). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="install_marker" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="install_marker" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
